{
  "name": "purplewren",
  "version": "1.1.0",
  "description": "Privacy-first, Proton-themed browser. Startpage search, tracker blocking, anti-fingerprinting, Tor & incognito tabs, built-in Lumo and Proton apps.",
  "main": "main.js",
  "license": "MIT",
  "author": "SkyshadowDerg",
  "repository": "https://github.com/SkyshadowDerg/PurpleWren",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win portable nsis",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^25.1.0"
  },
  "build": {
  "appId": "me.purplewren.browser",
  "productName": "PurpleWren",
  "publish": {
    "provider": "github",
    "owner": "YourUsername",
    "repo": "PurpleWren"
  },
  "files": [
    "main.js",
    "renderer/**/*"
  ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "renderer/icons/browser.ico",
      "target": [
        {
          "target": "nsis"
        },
        {
          "target": "portable"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer.nsh"
    },
    "linux": {
      "icon": "renderer/icons",
      "target": "AppImage",
      "category": "Network"
    }
  },
  "allowScripts": {
    "node-gyp@12.4.0": true,
    "tinyglobby@0.2.17": true,
    "picomatch@4.0.7": true,
    "fdir@6.5.0": true,
    "cacache@16.1.3": true,
    "tar@6.2.1": true,
    "make-fetch-happen@10.2.1": true
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "cross-fetch": "^4.1.0",
    "electron-updater": "^6.8.11"
  }
}
